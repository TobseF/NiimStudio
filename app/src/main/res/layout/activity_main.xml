<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not connected"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/printerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <!-- Connection -->
        <TextView style="@style/Section" android:text="Printer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/transport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan" />

            <CheckBox
                android:id="@+id/showAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All devices" />
        </LinearLayout>

        <Spinner
            android:id="@+id/devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/connect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connect" />

            <Button
                android:id="@+id/disconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disconnect" />

            <Button
                android:id="@+id/heartbeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Status" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/keepAlive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Keep-alive heartbeat every 5 s" />

        <!-- Label -->
        <TextView style="@style/Section" android:text="Label" />

        <EditText
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Label text (multi-line allowed)"
            android:inputType="textMultiLine"
            android:minLines="1"
            android:text="Hello B18" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/widthMm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Width mm (across tape)"
                android:inputType="numberDecimal"
                android:text="12" />

            <EditText
                android:id="@+id/lengthMm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Length mm (along tape)"
                android:inputType="numberDecimal"
                android:text="40" />

            <EditText
                android:id="@+id/copies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Copies"
                android:inputType="number"
                android:text="1" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="Width (mm across tape) · Length (mm along tape) · Copies" />

        <CheckBox
            android:id="@+id/border"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Draw border" />

        <!-- Print settings -->
        <TextView style="@style/Section" android:text="Print settings" />

        <TextView style="@style/Label" android:text="Density" />
        <Spinner
            android:id="@+id/density"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/Label" android:text="Label type" />
        <Spinner
            android:id="@+id/labelType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/Label" android:text="Protocol variant" />
        <Spinner
            android:id="@+id/variant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/Label" android:text="Rotation into print head (clockwise)" />
        <Spinner
            android:id="@+id/rotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Print head dots: " />

            <EditText
                android:id="@+id/printhead"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="96" />

            <CheckBox
                android:id="@+id/center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Center on head" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Packet delay ms: " />

            <EditText
                android:id="@+id/packetDelay"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="10" />

            <CheckBox
                android:id="@+id/indexed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Indexed rows (0x83)" />
        </LinearLayout>

        <!-- Preview & print -->
        <TextView style="@style/Section" android:text="Preview (1-bit, as sent)" />

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="#DDDDDD"
            android:padding="4dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/previewInfo"
            style="@style/Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/print"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Print label" />

            <Button
                android:id="@+id/printTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Print test pattern" />
        </LinearLayout>

        <TextView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <!-- Log -->
        <TextView style="@style/Section" android:text="Log" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/shareLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Share log" />

            <Button
                android:id="@+id/clearLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear log" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/logRows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log every bitmap row packet" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:textColor="#B5F5B5"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
